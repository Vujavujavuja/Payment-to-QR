# Optional. Only needed if you want the Claude vision extractor instead of
# the default in-browser Tesseract OCR. Without it the app still works —
# /api/extract just reports that the provider is unavailable.
ANTHROPIC_API_KEY=

# Optional. Overrides the model used by the Claude extractor.
# ANTHROPIC_MODEL=claude-opus-5

# Optional. The public origin of your deployment, used for canonical URLs, the
# sitemap, and Open Graph images — all of which must be absolute.
# Without it everything resolves against http://localhost:3000, which is
# correct for local development and wrong for anything you publish.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Rate limiting for /api/extract. Only POST is limited; the GET availability
# probe runs on every page load and costs nothing.
#
# These are courtesy limits held in process memory, not a security boundary:
# x-forwarded-for is client-supplied, and a host running several instances
# gives each its own counters. A public deployment with a key configured
# wants a shared store as well.
# EXTRACT_RATE_LIMIT=10           # per caller, per window
# EXTRACT_RATE_LIMIT_GLOBAL=100   # across all callers -- this one bounds the bill
# EXTRACT_RATE_WINDOW_MS=3600000  # one hour
